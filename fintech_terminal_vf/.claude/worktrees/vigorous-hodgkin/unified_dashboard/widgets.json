{
    "dealFlowDistribution": {
        "type": "chart",
        "name": "Deal Flow Distribution",
        "description": "Distribution of deal flow metrics over time.",
        "category": "Markets Monitor",
        "endpoint": "distribution",
        "gridData": {"w": 30, "h": 15},
        "params": [
            {"paramName": "start_date", "label": "Start Date", "type": "date", "value": "2024-01-01"},
            {"paramName": "end_date", "label": "End Date", "type": "date", "value": "2025-12-31"},
            {"paramName": "interval", "label": "Interval", "value": "3 month", "options": [{"label": "1 month", "value": "1 month"}, {"label": "3 month", "value": "3 month"}, {"label": "6 month", "value": "6 month"}, {"label": "9 month", "value": "9 month"}, {"label": "12 month", "value": "12 month"}], "type": "text"},
            {"paramName": "deal_type", "label": "Deal Type", "value": "", "options": [{"label": "All", "value": ""}, {"label": "Acquisition", "value": "Acquisition"}, {"label": "Refinance", "value": "Refinance"}, {"label": "Construction", "value": "Construction"}], "type": "text"},
            {"paramName": "metric", "label": "Metric", "value": "spread", "options": [{"label": "Spread", "value": "spread"}, {"label": "LTV", "value": "ltv"}, {"label": "Cap Rate", "value": "cap_rate"}], "type": "text"}
        ]
    },
    "dealFlowScatter": {
        "type": "chart",
        "name": "Deal Flow Scatter Plot",
        "description": "Scatter plot comparison of deal metrics.",
        "category": "Markets Monitor",
        "endpoint": "scatter",
        "gridData": {"w": 30, "h": 15},
        "params": [
            {"paramName": "start_date", "label": "Start Date", "type": "date", "value": "2024-01-01"},
            {"paramName": "end_date", "label": "End Date", "type": "date", "value": "2025-12-31"},
            {"paramName": "x_metric", "label": "X Axis Metric", "type": "text", "value": "ltv", "options": [{"label": "Spread", "value": "spread"}, {"label": "LTV", "value": "ltv"}, {"label": "Cap Rate", "value": "cap_rate"}, {"label": "LTC", "value": "ltc"}, {"label": "Debt Yield", "value": "debt_yield"}, {"label": "DSCR", "value": "dscr"}]},
            {"paramName": "y_metric", "label": "Y Axis Metric", "type": "text", "value": "spread", "options": [{"label": "Spread", "value": "spread"}, {"label": "LTV", "value": "ltv"}, {"label": "Cap Rate", "value": "cap_rate"}, {"label": "LTC", "value": "ltc"}, {"label": "Debt Yield", "value": "debt_yield"}, {"label": "DSCR", "value": "dscr"}]},
            {"paramName": "deal_type", "label": "Deal Type Filter", "type": "text", "value": "", "options": [{"label": "All Types", "value": ""}, {"label": "Acquisition", "value": "Acquisition"}, {"label": "Refinance", "value": "Refinance"}, {"label": "Construction", "value": "Construction"}]},
            {"paramName": "highlight_deal", "label": "Highlight Deal", "type": "endpoint", "value": "", "optionsEndpoint": "/deals/list", "description": "Select a deal to highlight on the chart."},
            {"paramName": "maturity_start", "type": "date", "value": "2024-01-01", "label": "Maturity Start"},
            {"paramName": "maturity_end", "type": "date", "value": "2027-12-31", "label": "Maturity End"}
        ]
    },
    "profitabilityRaincloud": {
        "type": "chart",
        "name": "Profitability Raincloud",
        "description": "Distribution density (cloud) with individual deal placement (rain).",
        "category": "Markets Monitor",
        "endpoint": "raincloud",
        "gridData": {"w": 30, "h": 15},
        "params": [
            {"paramName": "start_date", "label": "Start Date", "type": "date", "value": "2024-01-01"},
            {"paramName": "end_date", "label": "End Date", "type": "date", "value": "2025-12-31"},
            {"paramName": "deal_type", "label": "Deal Type", "value": "", "options": [{"label": "All", "value": ""}, {"label": "Acquisition", "value": "Acquisition"}, {"label": "Refinance", "value": "Refinance"}, {"label": "Construction", "value": "Construction"}], "type": "text"},
            {"paramName": "metric", "label": "Metric", "value": "spread", "options": [{"label": "Spread", "value": "spread"}, {"label": "LTV", "value": "ltv"}, {"label": "Cap Rate", "value": "cap_rate"}, {"label": "LTC", "value": "ltc"}, {"label": "Debt Yield", "value": "debt_yield"}, {"label": "DSCR", "value": "dscr"}], "type": "text"},
            {"paramName": "highlight_deal", "label": "Highlight Deal", "type": "endpoint", "value": "", "optionsEndpoint": "/deals/list", "description": "Select a deal to overlay on the distribution."}
        ]
    },
    "dealRadar": {
        "type": "chart",
        "name": "Deal vs Market Radar",
        "description": "Compare a specific deal against market median across up to 8 metrics.",
        "category": "Markets Monitor",
        "endpoint": "radar",
        "gridData": {"w": 20, "h": 15},
        "params": [
            {"paramName": "start_date", "label": "Start Date", "type": "date", "value": "2024-01-01"},
            {"paramName": "end_date", "label": "End Date", "type": "date", "value": "2025-12-31"},
            {"paramName": "deal_type", "label": "Deal Type Filter", "type": "text", "value": "", "options": [{"label": "All Types", "value": ""}, {"label": "Acquisition", "value": "Acquisition"}, {"label": "Refinance", "value": "Refinance"}, {"label": "Construction", "value": "Construction"}]},
            {"paramName": "metrics", "label": "Metrics (Max 8)", "type": "text", "value": "spread,ltv,dscr,debt_yield,cap_rate", "multiSelect": true, "options": [{"label": "Spread", "value": "spread"}, {"label": "LTV", "value": "ltv"}, {"label": "Cap Rate", "value": "cap_rate"}, {"label": "LTC", "value": "ltc"}, {"label": "Debt Yield", "value": "debt_yield"}, {"label": "DSCR", "value": "dscr"}], "description": "Select metrics to compare."},
            {"paramName": "highlight_deal", "label": "Select Deal", "type": "endpoint", "value": "", "optionsEndpoint": "/deals/list", "description": "The deal to compare against the market."}
        ]
    },
    "rentRollAnalysis": {
        "type": "chart",
        "name": "Rent Roll Expiration",
        "description": "Visualize lease expirations and cashflow decay over time for selected portfolios.",
        "category": "Portfolio Review",
        "endpoint": "cashflow",
        "gridData": {"w": 30, "h": 15},
        "params": [
            {"paramName": "portfolio", "label": "Select Portfolio", "type": "endpoint", "value": null, "optionsEndpoint": "/portfolios", "multiSelect": false, "description": "Choose a portfolio to analyze."},
            {"paramName": "buildings", "label": "Select Buildings", "type": "endpoint", "value": [], "optionsEndpoint": "/buildings", "multiSelect": true, "description": "Select specific buildings within the portfolio."},
            {"paramName": "group_by_tenant", "label": "Group by Tenant", "type": "boolean", "value": true, "description": "Toggle to group cashflows by Tenant (True) or Building (False)."}
        ]
    },
    "rentRollTable": {
        "type": "table",
        "name": "Rent Roll Data",
        "description": "Detailed lease data table for deep analysis.",
        "category": "Portfolio Review",
        "endpoint": "rent_roll",
        "gridData": {"w": 30, "h": 15},
        "params": [
            {"paramName": "portfolio", "label": "Select Portfolio", "type": "endpoint", "value": null, "optionsEndpoint": "/portfolios", "multiSelect": false, "description": "Choose a portfolio."},
            {"paramName": "buildings", "label": "Select Buildings", "type": "endpoint", "value": [], "optionsEndpoint": "/buildings", "multiSelect": true, "description": "Select specific buildings within the portfolio."}
        ]
    },
    "sharepoint_viewer": {
        "name": "SharePoint Multi-PDF Viewer",
        "description": "View and manage PDFs from SharePoint deals and folders.",
        "category": "Documents",
        "type": "multi_file_viewer",
        "endpoint": "documents",
        "gridData": {"w": 30, "h": 15},
        "params": [
            {"paramName": "portfolio", "label": "Portfolio", "type": "text", "multiSelect": true, "options": [{"label": "Real Estate", "value": "real_estate"}, {"label": "Corporate", "value": "corporate"}, {"label": "Project Finance", "value": "project_finance"}], "value": ["real_estate"], "description": "Select Portfolio(s)"},
            {"paramName": "deal_id", "label": "Deal", "type": "search", "optionsEndpoint": "deals", "value": "deal_alpha", "description": "Search for a Deal"},
            {"paramName": "filename", "label": "Widgets (Files)", "type": "endpoint", "optionsEndpoint": "files_list", "optionsParams": {"deal_id": "$deal_id", "portfolio": "$portfolio"}, "multiSelect": true, "roles": ["fileSelector"], "value": [], "description": "Select Files to View"}
        ]
    }
}