# Fintech Equity Research Terminal — Environment Variables
# These are injected by ODP when launching via the backend manager.
# For local development without ODP, copy this file to .env and fill in values.

# Polygon.io API key (equity market data, technicals, corporate actions)
POLYGON_API_KEY=your_polygon_api_key_here

# CoinGecko API key (crypto prices and returns)
COINGECKO_API_KEY=your_coingecko_api_key_here
