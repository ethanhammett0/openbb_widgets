            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "lon",
            "in": "path",
            "description": "The longitude of the center point.",
            "required": true,
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "radius",
            "in": "path",
            "description": "The radius in miles.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "trend",
            "in": "path",
            "description": "Indicates whether to include trend data.",
            "required": true,
            "schema": {
              "type": "boolean",
              "default": false
