    "/SpecialtyDemand/{lat}/{lon}/{radius}": {
      "get": {
        "tags": [
          "MarketData"
        ],
        "summary": "Returns Specialty Demand data for a given location, radius and Benchmark (optional; defaults to 'Top100') ex: 41.8849101, -87.6670655, 3, 'MD'.",
        "parameters": [
          {
            "name": "lat",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "lon",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "radius",
            "in": "path",
            "description": "",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Benchmark",
            "in": "query",
            "description": "Allowable inputs: CBSACodes, State Abbreviation (MD, CA, etc), Aggregates: 'Top100', 'Top50' etc.",
            "schema": {
              "type": "string",
              "default": "Top100"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpecialtyDemand"
                }
              }
            }
          }
        }
      }
    },
