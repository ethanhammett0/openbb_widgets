{
  "openapi": "3.0.1",
  "info": {
    "title": "RevistaMed API",
    "description": "Access to this API requires Revista Pro or Partner level access.<br><br>\r\n                        A valid 'ApiKey' query parameter is required for all requests. Missing or invalid keys will return 401 - Unauthorized.<br><br>\r\n                        API not intended for bulk data. Revista provides bulk data through FTP services.<br><br>\r\n                        Location based requests outside subscription access will not return data.",
    "termsOfService": "https://data.revistamed.com/terms-of-use",
    "contact": {
      "name": "Contact Revista",
      "url": "https://www.revistamed.com/contact"
    },
    "version": "v1"
  },
  "paths": {
    "/ConstructionByLatLon/{Lat}/{Lon}/{Radius}": {
      "get": {
        "tags": [
          "Construction"
        ],
        "summary": "Returns Construction properties within the radius(miles) of the lat/lon provided in.",
        "parameters": [
          {
            "name": "Lat",
            "in": "path",
            "description": "ex: 39.299236",
            "required": true,
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "Lon",
            "in": "path",
            "description": "ex: -76.609383",
            "required": true,
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "Radius",
            "in": "path",
            "description": "Radius in miles, ex: 3",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Construction"
                }
              }
            }
          }
        }
      }
    },
    "/ConstructionByProperty/{PropertyID}": {
